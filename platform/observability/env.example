OTEL_SERVICE_NAME=train-ticket-service
OTEL_RESOURCE_ATTRIBUTES=service.namespace=train-ticket,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Trace store retention window. Badger drops spans older than this. Raising it
# without also growing the Badger volume risks filling the disk -- see the
# capacity arithmetic in docs/07-observability/README.md before changing.
JAEGER_SPAN_STORE_TTL=12h
JAEGER_BADGER_VOLUME=train-ticket-jaeger-badger
