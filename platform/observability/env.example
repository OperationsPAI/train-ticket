OTEL_SERVICE_NAME=train-ticket-service
OTEL_RESOURCE_ATTRIBUTES=service.namespace=train-ticket,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Telemetry store. The retention window is applied by the collector's
# clickhouse exporter as a TTL clause on the tables it creates, so it only takes
# effect on a fresh store -- see docs/07-observability/README.md.
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=trainticket-otel
CLICKHOUSE_DB=otel
CLICKHOUSE_VOLUME=train-ticket-clickhouse-data
