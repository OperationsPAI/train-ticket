{
  "schemaVersion": "trainticket.metric-catalog/v1",
  "revision": "2026-09-28",
  "signedOffBy": "governance-review",
  "metrics": [
    {
      "metricId": "metric-ops-orders-per-second",
      "name": "Orders per second",
      "description": "Journey orders accepted per second, plotted against the arrival the release offers.",
      "owner": "operations-team",
      "category": "operational",
      "granularity": "hourly",
      "version": "1.0.0",
      "expression": "COUNT(JourneyOrderCreated) / 60",
      "status": "published",
      "publishedAt": "2026-09-27T00:00:00Z",
      "dependsOnMetricIds": [],
      "sourceLineage": ["JourneyOrderCreated", "OrderCreated"]
    },
    {
      "metricId": "metric-ops-payment-failures",
      "name": "Failed captures",
      "description": "Captures the payment context refused, counted from the facts it publishes.",
      "owner": "operations-team",
      "category": "operational",
      "granularity": "daily",
      "version": "1.0.0",
      "expression": "COUNT(PaymentFailed)",
      "status": "published",
      "publishedAt": "2026-09-27T00:00:00Z",
      "dependsOnMetricIds": [],
      "sourceLineage": ["PaymentFailed", "PaymentDeclined"]
    },
    {
      "metricId": "metric-ops-seat-utilisation",
      "name": "Seat utilisation",
      "description": "Confirmed seats over the capacity the release publishes, by route and service date.",
      "owner": "operations-team",
      "category": "operational",
      "granularity": "daily",
      "version": "1.0.0",
      "expression": "SUM(SeatAllocated) / SUM(CapacityUpdated)",
      "status": "published",
      "publishedAt": "2026-09-27T00:00:00Z",
      "dependsOnMetricIds": [],
      "sourceLineage": ["SeatAllocated", "SeatReleased", "CapacityUpdated"]
    },
    {
      "metricId": "metric-ops-refund-rate",
      "name": "Refund rate",
      "description": "Settled refunds over captures, the ratio the console reads beside the failed captures.",
      "owner": "operations-team",
      "category": "operational",
      "granularity": "daily",
      "version": "1.0.0",
      "expression": "COUNT(RefundSettled) / COUNT(PaymentCaptured)",
      "status": "published",
      "publishedAt": "2026-09-28T00:00:00Z",
      "dependsOnMetricIds": ["metric-ops-payment-failures"],
      "sourceLineage": ["RefundSettled", "RefundCompleted"]
    }
  ]
}
